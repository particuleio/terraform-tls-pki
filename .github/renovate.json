{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMajorReleases",
    ":prImmediately",
    ":gitSignOff",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "enabledManagers": [
    "github-actions",
    "mise",
    "pre-commit",
    "terraform"
  ],
  "semanticCommits": "enabled",
  "automerge": false,
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 20,
  "dependencyDashboardLabels": ["dependency-dashboard"],
  "commitMessageExtra": "to {{newVersion}} (was {{currentVersion}})",
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Label major updates",
      "matchUpdateTypes": ["major"],
      "addLabels": ["update-major", "breaking-change"]
    },
    {
      "description": "Label minor updates",
      "matchUpdateTypes": ["minor"],
      "addLabels": ["update-minor"]
    },
    {
      "description": "Label patch updates",
      "matchUpdateTypes": ["patch"],
      "addLabels": ["update-patch"]
    },
    {
      "description": "Label digest pinning and digest refreshes",
      "matchUpdateTypes": ["digest", "pinDigest"],
      "addLabels": ["update-digest"]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "semanticCommitScope": "ci",
      "semanticCommitType": "chore"
    },
    {
      "description": "Only low-risk automation updates are eligible for Mergify automerge",
      "matchManagers": [
        "github-actions",
        "mise",
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "addLabels": [
        "automerge-candidate"
      ]
    },
    {
      "matchManagers": [
        "mise",
        "pre-commit"
      ],
      "semanticCommitScope": "ci",
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "semanticCommitScope": "tf",
      "semanticCommitType": "feat"
    }
  ]
}
